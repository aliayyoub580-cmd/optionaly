# ==============================================================================
# SUPABASE & POSTGRESQL DATABASE CREDENTIALS
# ==============================================================================
# Supabase Project Connection URL (required for complete transactional backend support)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[DATABASE-PASSWORD]@[REGION].pooler.supabase.com:6543/postgres"

# Supabase API & SDK Credentials (From Supabase Project Settings -> API)
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="sb_publishable_[YOUR-PUBLISHABLE-KEY]"
# Keep this server-only. Use an sb_secret_ key (or the legacy service_role key).
SUPABASE_SERVICE_ROLE_KEY="sb_secret_[YOUR-SERVER-SECRET]"

# ==============================================================================
# SERVER & RUNTIME ENVIRONMENT
# ==============================================================================
PORT=4000
NODE_ENV=production
JWT_SECRET="generate-a-long-random-secret"

# Domain & CORS Configurations
FRONTEND_URL=https://optionaly.com
BACKEND_URL=https://api.optionaly.com
API_BASE_URL=https://api.optionaly.com
CORS_ORIGIN=https://optionaly.com

# NOWPayments Crypto Gateway Credentials
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_BASE_URL=https://api.nowpayments.io/v1

# WPay (OKExPay) PKR Payment Gateway Credentials
WPAY_BASE_URL=https://api.wpay.life
WPAY_MERCHANT_ID=
WPAY_API_KEY=

# Admin Credentials
ADMIN_LOGIN_PATH=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
